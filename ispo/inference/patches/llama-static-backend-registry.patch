+namespace {
+
+struct ispo_backend_registry {
+    std::vector<ggml_backend_reg_t> backends;
+    std::vector<ggml_backend_dev_t> devices;
+
+    ispo_backend_registry() {
+#ifdef GGML_USE_METAL
+        register_backend(ggml_backend_metal_reg());
+#endif
+#ifdef GGML_USE_BLAS
+        register_backend(ggml_backend_blas_reg());
+#endif
+#ifdef GGML_USE_CPU
+        register_backend(ggml_backend_cpu_reg());
+#endif
+    }
+
+    void register_backend(ggml_backend_reg_t reg) {
+        if (reg == nullptr || std::find(backends.begin(), backends.end(), reg) != backends.end()) {
+            return;
+        }
+        backends.push_back(reg);
+        for (size_t index = 0; index < ggml_backend_reg_dev_count(reg); ++index) {
+            register_device(ggml_backend_reg_dev_get(reg, index));
+        }
+    }
+
+    void register_device(ggml_backend_dev_t device) {
+        if (device != nullptr && std::find(devices.begin(), devices.end(), device) == devices.end()) {
+            devices.push_back(device);
+        }
+    }
+};
+
+ispo_backend_registry & ispo_registry() {
+    static ispo_backend_registry registry;
+    return registry;
+}
+
+bool ispo_equals_ignore_case(const char * left, const char * right) {
+    while (*left != '\0' && *right != '\0') {
+        const auto lhs = static_cast<unsigned char>(*left);
+        const auto rhs = static_cast<unsigned char>(*right);
+        if (std::tolower(lhs) != std::tolower(rhs)) {
+            return false;
+        }
+        ++left;
+        ++right;
+    }
+    return *left == *right;
+}
+
+}  // namespace
+
+void ggml_backend_register(ggml_backend_reg_t reg) {
+    ispo_registry().register_backend(reg);
+}
+
+void ggml_backend_device_register(ggml_backend_dev_t device) {
+    ispo_registry().register_device(device);
+}
+
+size_t ggml_backend_reg_count() {
+    return ispo_registry().backends.size();
+}
+
+ggml_backend_reg_t ggml_backend_reg_get(size_t index) {
+    GGML_ASSERT(index < ggml_backend_reg_count());
+    return ispo_registry().backends[index];
+}
+
+ggml_backend_reg_t ggml_backend_reg_by_name(const char * name) {
+    for (const ggml_backend_reg_t reg : ispo_registry().backends) {
+        if (ispo_equals_ignore_case(ggml_backend_reg_name(reg), name)) {
+            return reg;
+        }
+    }
+    return nullptr;
+}
+
+size_t ggml_backend_dev_count() {
+    return ispo_registry().devices.size();
+}
+
+ggml_backend_dev_t ggml_backend_dev_get(size_t index) {
+    GGML_ASSERT(index < ggml_backend_dev_count());
+    return ispo_registry().devices[index];
+}
+
+ggml_backend_dev_t ggml_backend_dev_by_name(const char * name) {
+    for (const ggml_backend_dev_t device : ispo_registry().devices) {
+        if (ispo_equals_ignore_case(ggml_backend_dev_name(device), name)) {
+            return device;
+        }
+    }
+    return nullptr;
+}
+
+ggml_backend_dev_t ggml_backend_dev_by_type(enum ggml_backend_dev_type type) {
+    for (const ggml_backend_dev_t device : ispo_registry().devices) {
+        if (ggml_backend_dev_type(device) == type) {
+            return device;
+        }
+    }
+    return nullptr;
+}
+
+ggml_backend_t ggml_backend_init_by_name(const char * name, const char * params) {
+    const ggml_backend_dev_t device = ggml_backend_dev_by_name(name);
+    return device == nullptr ? nullptr : ggml_backend_dev_init(device, params);
+}
+
+ggml_backend_t ggml_backend_init_by_type(enum ggml_backend_dev_type type, const char * params) {
+    const ggml_backend_dev_t device = ggml_backend_dev_by_type(type);
+    return device == nullptr ? nullptr : ggml_backend_dev_init(device, params);
+}
+
+ggml_backend_t ggml_backend_init_best(void) {
+    const ggml_backend_dev_t accelerator = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    const ggml_backend_dev_t cpu =
+        accelerator == nullptr ? ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU) : accelerator;
+    return cpu == nullptr ? nullptr : ggml_backend_dev_init(cpu, nullptr);
+}
+
+ggml_backend_reg_t ggml_backend_load(const char *) {
+    return nullptr;
+}
+
+void ggml_backend_unload(ggml_backend_reg_t) {}
+
+void ggml_backend_load_all() {
+    (void) ispo_registry();
+}
+
+void ggml_backend_load_all_from_path(const char *) {
+    (void) ispo_registry();
+}
