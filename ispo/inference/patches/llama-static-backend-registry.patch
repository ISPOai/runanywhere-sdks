--- /dev/null
+++ b/ggml/src/ggml-ispo-sealed-env.h
@@ -0,0 +1,27 @@
+#pragma once
+
+// The sealed ISPO target deliberately has no process-environment configuration
+// surface. Keep upstream tuning and debug toggles compiled out instead of
+// letting them discover ambient process state.
+#ifdef __cplusplus
+#include <cstdlib>
+static inline char * ggml_ispo_sealed_getenv(const char *) {
+    return nullptr;
+}
+#else
+#include <stdlib.h>
+static inline char * ggml_ispo_sealed_getenv(const char * name) {
+    (void) name;
+    return NULL;
+}
+#endif
+
+static inline int ggml_ispo_sealed_setenv(const char * name, const char * value, int overwrite) {
+    (void) name;
+    (void) value;
+    (void) overwrite;
+    return 0;
+}
+
+#define getenv(name) ggml_ispo_sealed_getenv(name)
+#define setenv(name, value, overwrite) ggml_ispo_sealed_setenv(name, value, overwrite)
