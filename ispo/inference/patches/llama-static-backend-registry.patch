+#pragma once
+
+// The ISPO artifact has no ambient-process configuration surface. The sealed
+// source slice must not discover backend, tracing, or Metal behavior through
+// environment variables.
+#ifdef __cplusplus
+static inline char* ggml_ispo_sealed_getenv(const char*) {
+    return nullptr;
+}
+#else
+static inline char* ggml_ispo_sealed_getenv(const char* name) {
+    (void)name;
+    return NULL;
+}
+#endif
+
+#define getenv(name) ggml_ispo_sealed_getenv(name)
